{
  "name": "dos-orillas-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "predev": "node scripts/prepare-narrative-styles.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "prebuild": "pnpm assets:manifest && node scripts/prepare-narrative-styles.mjs",
    "build": "next build --webpack",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "assets:manifest": "node scripts/build-asset-manifest.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "test:e2e": "playwright test",
    "qa:phase": "node scripts/qa-phase.mjs",
    "perf:lh": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@studio-freight/lenis": "^1.0.42",
    "clsx": "^2.1.1",
    "framer-motion": "^14.2.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "lighthouse": "^13.0.0",
    "prettier": "^3.0.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
